# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site (used in certificate QR codes and payment callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paystack (Kenya). Card payments are charged in USD, M-Pesa in KES.
PAYSTACK_SECRET_KEY=
# KES per 1 USD, used to quote M-Pesa payments. Set the rate the client wants to use.
USD_TO_KES=

# First admin account (used by `npm run seed` to promote this email to admin after they sign up)
ADMIN_EMAIL=Aspiresafetystandards@gmail.com
